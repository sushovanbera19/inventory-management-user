# Copy this file to ".env" and adjust. Vite only exposes variables that start with VITE_.

# true  -> the app runs on built-in demo data kept in the browser (no server needed)
# false -> every request goes to your backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Base URL of your backend API (used only when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000/api
